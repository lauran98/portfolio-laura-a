<a class="skip-link" href="#main">Skip to main content</a>

<header class="site-header">
  <div class="container site-header__inner">

    <a class="brand" href="{{ '/' | url }}">
      <svg class="brand__mark" width="26" height="26" viewBox="0 0 26 26"
           aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="13" cy="13" r="11" />
        <ellipse cx="13" cy="13" rx="5" ry="11" />
        <path d="M2.4 9.5h21.2M2.4 16.5h21.2" />
        <circle cx="13" cy="13" r="2.4" fill="#D9824B" stroke="none" />
      </svg>
      <span class="brand__name">{{ site.shortName }}</span>
    </a>

    <button class="nav-toggle" type="button"
            aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="nav-toggle__bars" aria-hidden="true"><span></span></span>
      <span>Menu</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main" data-nav>
      <ul>
        {% for item in nav %}
          <li>
            <a href="{{ item.url | url }}"
               {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.text }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>

  </div>
</header>
